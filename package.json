{
  "name": "@hegetim/graph-harvester-react",
  "version": "0.2.0-rc.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/graph-harvester-react.js",
  "module": "./dist/graph-harvester-react.js",
  "types": "./dist/graph-harvester-react.d.ts",
  "exports": {
    ".": {
      "types": "./dist/graph-harvester-react.d.ts",
      "import": "./dist/graph-harvester-react.js"
    },
    "./style.css": "./dist/graph-harvester-react.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --emitDeclarationOnly false && tsc -p tsconfig.node.json && tsc -p tests/tsconfig.json",
    "test": "vitest run",
    "test:pdfjs": "vitest run tests/pdfjs-poc.test.ts",
    "test:watch": "vitest",
    "test:update": "vitest run --update",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "bootstrap": "^5.3.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.9",
    "@napi-rs/canvas": "1.1.0",
    "@types/node": "^24.12.3",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "mupdf": "1.28.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.0.2",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "kdbush": "^4.1.0",
    "pdfjs-dist": "6.5.438",
    "rbush": "^4.0.1"
  }
}
